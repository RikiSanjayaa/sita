# Salin ke deploy.env di folder deployment VM. Jangan commit deploy.env.
# Gunakan tag sha-<commit> atau digest, bukan latest.
SITA_APP_IMAGE=ghcr.io/rikisanjayaa/sita-app:sha-f7756d0
SITA_WEB_IMAGE=ghcr.io/rikisanjayaa/sita-web:sha-f7756d0
SITA_PULL_POLICY=always

# Setelah aaPanel menjadi reverse proxy, ubah menjadi 127.0.0.1.
SITA_WEB_BIND=0.0.0.0
SITA_WEB_PORT=8088
